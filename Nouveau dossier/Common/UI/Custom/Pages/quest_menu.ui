$C = "../Common.ui";

// --- STYLY ---
@GreenButtonStyle = TextButtonStyle(
  Default: (Background: #27ae60, LabelStyle: (FontSize: 16, TextColor: #ffffff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
  Hovered: (Background: #2ecc71, LabelStyle: (FontSize: 16, TextColor: #ffffff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
  Pressed: (Background: #1e8449, LabelStyle: (FontSize: 16, TextColor: #cccccc, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center))
);

@RedButtonStyle = TextButtonStyle(
  Default: (Background: #c0392b, LabelStyle: (FontSize: 14, TextColor: #ffffff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
  Hovered: (Background: #e74c3c, LabelStyle: (FontSize: 14, TextColor: #ffffff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
  Pressed: (Background: #a93226, LabelStyle: (FontSize: 14, TextColor: #cccccc, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center))
);

@CloseButtonStyle = TextButtonStyle(
  Default: (Background: #34495e, LabelStyle: (FontSize: 14, TextColor: #ffffff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
  Hovered: (Background: #2c3e50, LabelStyle: (FontSize: 14, TextColor: #ffffff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
  Pressed: (Background: #2c3e50, LabelStyle: (FontSize: 14, TextColor: #95a5a6, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center))
);

// --- HLAVNÍ SKUPINA ---
Group {
  Anchor: (Width: 450, Height: 350);
  LayoutMode: Top;
  Background: #141c26(0.98);
  Padding: (Full: 20);

  // Nadpis - PŘIDÁNO ID #questHeadline
  Label #questHeadline {
    Text: "ADVENTURE QUESTS";
    Anchor: (Height: 40);
    Style: (FontSize: 24, TextColor: #f39c12, HorizontalAlignment: Center, RenderBold: true);
  }

  Group { Anchor: (Height: 1); Background: #2b3542; }
  Group { Anchor: (Height: 20); }

  // Informace o questu
  Group {
    LayoutMode: Top;
    FlexWeight: 1;
    
    Label #questTitle {
      Text: "No Active Quest";
      Anchor: (Height: 30);
      Style: (FontSize: 18, TextColor: #ffffff, HorizontalAlignment: Center);
    }
    
    Label #questDesc {
      Text: "You are currently free of duty.";
      Anchor: (Height: 25);
      Style: (FontSize: 14, TextColor: #95a5a6, HorizontalAlignment: Center);
    }

    Label #questProgress {
      Text: "";
      Anchor: (Height: 25);
      Style: (FontSize: 16, TextColor: #2ecc71, HorizontalAlignment: Center, RenderBold: true);
    }
    
    Label #questReward {
      Text: "";
      Anchor: (Height: 25);
      Style: (FontSize: 14, TextColor: #3498db, HorizontalAlignment: Center);
    }
  }

  // Tlačítka dole
  Group {
    LayoutMode: Center;
    Anchor: (Height: 50);

    TextButton #newQuestButton {
      Text: "START NEW";
      Anchor: (Width: 150, Height: 40);
      Style: @GreenButtonStyle;
    }
    
    Group { Anchor: (Width: 10); }

    TextButton #abandonButton {
      Text: "ABANDON";
      Anchor: (Width: 150, Height: 40);
      Style: @RedButtonStyle;
    }
  }
  
  Group { Anchor: (Height: 10); }
  
  // Close tlačítko
  Group {
    LayoutMode: Center;
    TextButton #closeButton {
      Text: "CLOSE";
      Anchor: (Width: 100, Height: 30);
      Style: @CloseButtonStyle;
    }
  }
}