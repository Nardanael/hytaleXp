$C = "../Common.ui";

// Styly
@CloseButtonStyle = TextButtonStyle(
  Default: (Background: #34495e, LabelStyle: (FontSize: 14, TextColor: #ffffff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
  Hovered: (Background: #2c3e50, LabelStyle: (FontSize: 14, TextColor: #ffffff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
  Pressed: (Background: #2c3e50, LabelStyle: (FontSize: 14, TextColor: #95a5a6, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center))
);

@ResetButtonStyle = TextButtonStyle(
  Default: (Background: #c0392b, LabelStyle: (FontSize: 14, TextColor: #ffffff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
  Hovered: (Background: #e74c3c, LabelStyle: (FontSize: 14, TextColor: #ffffff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
  Pressed: (Background: #a93226, LabelStyle: (FontSize: 14, TextColor: #cccccc, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center))
);

Group {
  Anchor: (Width: 500, Height: 500);
  LayoutMode: Top;
  Background: #141c26(0.98);
  Padding: (Full: 20);

  // Nadpis - PŘIDÁNO ID #TitleLabel
  Label #TitleLabel {
    Text: "PLAYER STATISTICS";
    Anchor: (Height: 45);
    Style: (FontSize: 24, TextColor: #f1c40f, HorizontalAlignment: Center, RenderBold: true);
  }
  
  Group { Anchor: (Height: 1); Background: #2b3542; }
  Group { Anchor: (Height: 20); }

  // --- STATISTIKY ---
  Group {
    LayoutMode: Left; Anchor: (Height: 30);
    // PŘIDÁNO ID #LabelMining
    Label #LabelMining { Text: "Mining:"; Anchor: (Width: 150); Style: (FontSize: 18, TextColor: #3498db, VerticalAlignment: Center); }
    Label #MiningLevel { Text: "Lvl 0"; Anchor: (Width: 120); Style: (FontSize: 18, TextColor: #ffffff, RenderBold: true, VerticalAlignment: Center); }
    Label #MiningXP { Text: "(0 XP)"; Style: (FontSize: 14, TextColor: #7f8c8d, VerticalAlignment: Center); }
  }
  Group { Anchor: (Height: 10); }

  Group {
    LayoutMode: Left; Anchor: (Height: 30);
    // PŘIDÁNO ID #LabelWood
    Label #LabelWood { Text: "Woodcutting:"; Anchor: (Width: 150); Style: (FontSize: 18, TextColor: #2ecc71, VerticalAlignment: Center); }
    Label #WoodLevel { Text: "Lvl 0"; Anchor: (Width: 120); Style: (FontSize: 18, TextColor: #ffffff, RenderBold: true, VerticalAlignment: Center); }
    Label #WoodXP { Text: "(0 XP)"; Style: (FontSize: 14, TextColor: #7f8c8d, VerticalAlignment: Center); }
  }
  Group { Anchor: (Height: 10); }

  Group {
    LayoutMode: Left; Anchor: (Height: 30);
    // PŘIDÁNO ID #LabelFarm
    Label #LabelFarm { Text: "Farming:"; Anchor: (Width: 150); Style: (FontSize: 18, TextColor: #f1c40f, VerticalAlignment: Center); }
    Label #FarmLevel { Text: "Lvl 0"; Anchor: (Width: 120); Style: (FontSize: 18, TextColor: #ffffff, RenderBold: true, VerticalAlignment: Center); }
    Label #FarmXP { Text: "(0 XP)"; Style: (FontSize: 14, TextColor: #7f8c8d, VerticalAlignment: Center); }
  }
  Group { Anchor: (Height: 10); }

  Group {
    LayoutMode: Left; Anchor: (Height: 30);
    // PŘIDÁNO ID #LabelCombat
    Label #LabelCombat { Text: "Combat:"; Anchor: (Width: 150); Style: (FontSize: 18, TextColor: #e74c3c, VerticalAlignment: Center); }
    Label #CombatLevel { Text: "Lvl 0"; Anchor: (Width: 120); Style: (FontSize: 18, TextColor: #ffffff, RenderBold: true, VerticalAlignment: Center); }
    Label #CombatXP { Text: "(0 XP)"; Style: (FontSize: 14, TextColor: #7f8c8d, VerticalAlignment: Center); }
  }
  Group { Anchor: (Height: 10); }

  Group {
    LayoutMode: Left; Anchor: (Height: 30);
    // PŘIDÁNO ID #LabelMagic
    Label #LabelMagic { Text: "Magic:"; Anchor: (Width: 150); Style: (FontSize: 18, TextColor: #9b59b6, VerticalAlignment: Center); }
    Label #MagicLevel { Text: "Lvl 0"; Anchor: (Width: 120); Style: (FontSize: 18, TextColor: #ffffff, RenderBold: true, VerticalAlignment: Center); }
    Label #MagicXP { Text: "(0 XP)"; Style: (FontSize: 14, TextColor: #7f8c8d, VerticalAlignment: Center); }
  }

  Group { FlexWeight: 1; }
  Group { Anchor: (Height: 1); Background: #2b3542(0.5); }
  Group { Anchor: (Height: 16); }

  // --- TLAČÍTKA ---
  Group {
    LayoutMode: Center;
    Anchor: (Height: 44);
    
    // Tlačítko pro RESET (Červené)
    TextButton #ResetButton {
      Text: "RESET ALL";
      Anchor: (Width: 120, Height: 40);
      Style: @ResetButtonStyle;
    }

    Group { Anchor: (Width: 20); }

    // Tlačítko pro ZAVŘÍT (Šedé)
    TextButton #CloseButton {
      Text: "CLOSE";
      Anchor: (Width: 120, Height: 40);
      Style: @CloseButtonStyle;
    }
  }
}